              "pm.test(\"Response has post data\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property('id', 1);\r",
              "    pm.expect(jsonData).to.have.property('title');\r",
              "});"
