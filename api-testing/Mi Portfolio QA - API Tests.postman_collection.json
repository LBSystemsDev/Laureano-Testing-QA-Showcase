    {
      "name": "POST - Crear post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Test 1: Verificar que se creó correctamente (código 201 = Created)\r",
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "// Test 2: Verificar que la respuesta tiene un ID (fue creado)\r",
              "pm.test(\"Post fue creado y tiene ID\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property('id');\r",
              "    pm.expect(jsonData.id).to.not.be.null;\r",
              "});\r",
              "\r",
              "// Test 3: Verificar que el título es el que enviamos\r",
              "pm.test(\"El titulo es correcto\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.title).to.equal(\"Mi portfolio QA\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "packages": {},
            "type": "text/javascript"
          }
        }
