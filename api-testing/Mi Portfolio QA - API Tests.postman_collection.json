          "listen": "test",
          "script": {
            "exec": [
              "// Test 1: Verificar que se actualizó correctamente (código 200)\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Test 2: Verificar que el título se actualizó\r",
              "pm.test(\"El titulo fue actualizado correctamente\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.title).to.equal(\"Actualizado para mi portfolio QA\");\r",
              "});\r",
              "\r",
              "// Test 3: Verificar que el ID no cambió\r",
              "pm.test(\"El ID sigue siendo 1\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.id).to.equal(1);\r",
              "});"
